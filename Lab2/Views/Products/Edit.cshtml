@{
}

@model Lab2.Models.ProductModel

<br />
<br />
<div class="w-100 d-flex flex-column align-items-center mx-5 mt-5">
	<a asp-area="" asp-controller="Products" asp-action="Products">See All Products</a>

	<h3>Edit Product</h3>

	@if (Model is null)
	{
		<p>No product was found with this Id</p>
	}

	@if (Model is not null)
	{
		<form method="post">
				<div class="mt-3">
					<label class="form-label">Id</label>
					<input type="text" class="form-control" asp-for="Id" readonly />
				</div>

				<div class="mt-3">
					<label class="form-label">Name</label>
					<input type="text" class="form-control" asp-for="Name" />
				</div>

				<div class="mt-3">
					<label class="form-label">Model</label>
					<input type="text" class="form-control" asp-for="Model" />
				</div>

				<div class="mt-3">
					<label class="form-label">Category</label>
					<input type="text" class="form-control" asp-for="Category" />
				</div>

				<div class="mt-3">
					<label class="form-label">Memory</label>
					<input type="number" class="form-control" asp-for="Memory" />
				</div>

				<div class="mt-3">
					<button type="submit" class="btn btn-primary">Update</button>

				<button type="submit" class="btn btn-danger ms-3"
						asp-action="Delete"
						asp-controller="Products">Delete</button>
				</div>
			</form>
	}
	

</div>