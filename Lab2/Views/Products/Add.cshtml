@{
}

@model Lab2.Models.AddProductViewModel

<br />
<br />
<div class="w-100 d-flex flex-column align-items-center mx-5 mt-5">
	<a asp-area="" asp-controller="Products" asp-action="Products">See All Products</a>

	<h3>Create new product</h3>

	<form method="post">
		<div class="mt-3">
			<label class="form-label">Name</label>
			<input type="text" class="form-control" asp-for="Name" />
		</div>

		<div class="mt-3">
			<label class="form-label">Model</label>
			<input type="text" class="form-control" asp-for="Model" />
		</div>

		<div class="mt-3">
			<label class="form-label">Category</label>
			<input type="text" class="form-control" asp-for="Category" />
		</div>

		<div class="mt-3">
			<label class="form-label">Memory</label>
			<input type="number" class="form-control" asp-for="Memory" />
		</div>

		<div class="mt-3">
			<button type="submit" class="btn btn-primary">Create</button>
		</div>
	</form>
	
</div>

    

